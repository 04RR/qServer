# llama-swap v240 config — PROFILE: Q6_K_M (UD imatrix, quality). Toggle with config.yaml.plain.
# CHAT models are MUTUALLY EXCLUSIVE — one on the GPUs at a time (27B dense+vision, 35B, 35B-batch,
# 122B tri-tier, flash-next 125B) + the on-demand GPU embedder. The CPU embedder is concurrent/persistent.
#
# SCHEMA NOTE (verified against config.example.yaml @ tag v240, not from memory):
#   `groups` is NOT top-level any more — it moved under routing.router.settings.groups.
#
# WHY ONE GROUP CONTAINING ALL: swap:true = only one member runs at a time; exclusive:true =
# loading a member unloads every other group. The 27B, 35B, 122B each need both GPUs (the 122B
# also ~15 GiB RAM); no two can coexist, so they must share ONE swap:true group.
#
# WHY cmd POINTS AT THE RUN SCRIPT: it encodes every hard-won flag (layer split, q8_0 KV, mmproj,
# MTP). The script `exec`s the binary, so the PID llama-swap tracks IS llama-server (SIGTERM
# reaches the real process). Here the primary's MODEL/MMPROJ/TS/SPEC_NMAX are env-injected.

healthCheckTimeout: 900
logLevel: info
startPort: 10001
unloadTimeout: 30

models:
  # PRIMARY DENSE + NATIVE VISION — Qwen3.8-27B-UD-Q6_K_M (imatrix dynamic quant, ~Q8-leaning
  # quality). Tuned for the code/RAG + vision usecase: -ts 4,1 pushes weight onto the 4090 (+7%
  # short-context tg); SPEC_NMAX=5 lifts RAG-depth tg +14% (AL 4.3->5.0). GPU0 ~1.5-1.9 GiB free
  # with vision resident; certified gates38 17/0 at these exact params. Plain Q6_K is ~8% faster
  # but lower quality — switch to it with `cp config.yaml.plain config.yaml && restart`.
  "qwen-38-27b":
    name: "Qwen3.8-27B dense + vision (4090 + 5060 Ti) [UD-Q6_K_M]"
    description: "Dense qwen3_5 27B UD-Q6_K_M (imatrix/quality), native VLM (mmproj-F16), -ts 4,1, MTP n=5 (RAG-tuned), 131072 ctx, q8_0 KV."
    cmd: >-
      env
      MODEL=/home/rohit/ai/qwen36/models/Qwen38-27B-6_K_M/Qwen3.8-27B-UD-Q6_K_M.gguf
      MMPROJ=/home/rohit/ai/qwen36/models/Qwen38-27B-6_K_M/mmproj-Qwen3.8-F16.gguf
      TS=4,1 SPEC_NMAX=5
      /home/rohit/ai/qwen36/run-38-27b.sh
    proxy: http://127.0.0.1:8080
    checkEndpoint: /health
    ttl: 0
    aliases:
      - "qwen38"
      - "qwen38-27b"
      - "qwen36"                       # legacy: existing clients / regress.sh send this -> now 3.8
      - "qwen36-q6"
      - "qwen36-text"

  "qwen-35b":
    name: "Qwen3.6-35B-A3B MoE (4090 + 5060 Ti)"
    description: "MoE 35B, min-spill expert offload (blk.28-33 -> CUDA1), MTP n=3, 131072 ctx."
    cmd: /home/rohit/ai/qwen36/run-text-35b.sh
    proxy: http://127.0.0.1:8082
    checkEndpoint: /health
    ttl: 0
    aliases:
      - "qwen36-35b"

  # BATCH-CLASSIFICATION VARIANT of qwen-35b — same GGUF, same placement, 4 parallel slots.
  # Added for signalpost's SCORE stage (many small grammar-constrained requests). SEPARATE entry
  # rather than -np 4 on qwen-35b because -c is the TOTAL context divided across slots: -np 4 would
  # silently cut every existing caller's per-request ctx from 131072 to 32768. Total KV/VRAM identical.
  # Same exclusive group, so never resident alongside another chat model.
  "qwen-35b-batch":
    name: "Qwen3.6-35B-A3B MoE — batch (4 slots x 32k)"
    description: "Same model/placement as qwen-35b with -np 4. For many small concurrent requests (classification, scoring). Per-slot ctx 32768."
    cmd: >-
      env NP=4 PORT=8083
      /home/rohit/ai/qwen36/run-text-35b.sh
    proxy: http://127.0.0.1:8083
    checkEndpoint: /health
    ttl: 0
    aliases:
      - "qwen36-35b-batch"

  # PERSISTENT EMBEDDER — Qwen3-Embedding-0.6B, CPU (zero VRAM), resident CONCURRENTLY with the chat model
  # via a `persistent` group (survives the chat group's exclusive swaps). OpenAI /v1/embeddings on :8086.
  # RAG: embed the query on qwen-embed, chat on qwen38 — separate processes, so no queueing between them.
  "qwen-embed":
    name: "Qwen3-Embedding-0.6B (CPU, concurrent)"
    description: "0.6B embedder, CPU -ngl 0 (zero VRAM), last-token pooling, 1024-dim, :8086. Always resident, coexists with any chat model."
    cmd: /home/rohit/ai/qwen36/run-embed.sh
    proxy: http://127.0.0.1:8086
    checkEndpoint: /health
    ttl: 0
    aliases:
      - "qwen3-embed"
      - "embed"

  # ON-DEMAND GPU EMBEDDER — same 0.6B model on the 4090 (NGL=99, DEV=0), :8088, for HEAVY bulk indexing.
  # Member of the gpu-exclusive SWAP group: routing to it EVICTS the chat model and takes the whole 4090
  # (full 1008 GB/s) for the duration; the next chat request evicts it right back. Use the CPU qwen-embed
  # for light query embeds (coexists with chat); use this only for batch corpus indexing.
  "qwen-embed-gpu":
    name: "Qwen3-Embedding-0.6B (4090, on-demand heavy)"
    description: "Same embedder on the 4090 (NGL=99, DEV=0), :8088. On-demand bulk indexing; evicts the chat model while it runs, yields VRAM back on the next chat. 1024-dim, last-token pooling."
    cmd: >-
      env NGL=99 DEV=0 PORT=8088 /home/rohit/ai/qwen36/run-embed.sh
    proxy: http://127.0.0.1:8088
    checkEndpoint: /health
    ttl: 0
    aliases:
      - "embed-gpu"
      - "qwen3-embed-gpu"

  # QWEN3.8-FLASH-NEXT — qwen4exp 125B-A6B multimodal MoE + 51.2B-elem PLE + MTP draft head.
  # ISOLATED binary at ~/ai/flashnext/llama.cpp (MTP branch d1a92352, build 10802) — NOT this stack's
  # llama.cpp. PLE (per_layer_token_embd, 27.5 GiB IQ4_NL) is lazy-mmap on NVMe; routed experts split
  # GPU/RAM via NCM=31; -ts 40,8 puts the expert-heavy HIGH layers on the 4090 (NCM sends LOW layers'
  # experts to CPU, and -sm layer would otherwise pile the high end onto the 16GB 5060 Ti -> OOM).
  # f16 KV (q8_0 asserts on the QSA path). --no-warmup = fast swap-in (first request faults lazily).
  # gpu-exclusive member: loading it evicts the chat model; the next chat request evicts it back.
  "qwen-38-flash-next":
    name: "Qwen3.8-Flash-Next (qwen4exp 125B-A6B MoE+PLE+MTP, 4090+5060Ti+RAM)"
    description: "125B-A6B multimodal MoE; PLE lazy-mmap on NVMe, MTP draft head. NCM=31 TS=40,8 f16 KV, 131072 ctx, ~18.8 t/s (MTP on)."
    cmd: >-
      env NO_WARMUP=1 NCM=31 TS=40,8 MG=0 CTX=131072 NMAX=2 VISION=on PORT=8085
      /home/rohit/ai/flashnext/run-38-flash-next.sh
    proxy: http://127.0.0.1:8085
    checkEndpoint: /health
    ttl: 0
    unloadTimeout: 30
    aliases:
      - "flash-next"
      - "qwen38-next"

  # BATCH / THROUGHPUT variant of qwen-38-flash-next — same 125B GGUF + placement, but -np 4 (4 parallel
  # slots), MTP OFF (net loss at concurrency), VISION OFF (text-only). The CPU expert tier is the decode
  # wall; batching amortizes each RAM expert-read across concurrent sequences, so THROUGHPUT scales even
  # though single-token latency doesn't. For bulk indexing/scoring, not interactive chat. -c is TOTAL ctx
  # / slots -> 32768 per slot at NP=4. Same exclusive group; ~150 s cold swap-in. NCM=28 TS=37,11: rebalanced
  # toward GPU1 (MTP-off freed ~4 GiB there) — GPU0 keeps ~9 expert layers, GPU1 takes 11 (was 8) => +3 off CPU.
  # Verified GPU0 20724/GPU1 15094 (1.2 free); +17% aggregate throughput @8-concurrent vs NCM=31,40/8. (NCM<31 at
  # TS=40,8 OOMs GPU0 — the freed VRAM is on GPU1, reached only by lowering the split; NCM=26 here would be tighter.)
  "qwen-38-flash-next-batch":
    name: "Qwen3.8-Flash-Next — batch (4 slots x 32k, MTP off, text-only)"
    description: "Same 125B GGUF/placement as qwen-38-flash-next with -np 4, MTP off, vision off. Bulk throughput (indexing/scoring): amortizes the CPU expert reads across concurrent sequences. Per-slot ctx 32768."
    cmd: >-
      env NP=4 SPEC_OFF=1 VISION=off NO_WARMUP=1 NCM=28 TS=37,11 MG=0 CTX=131072 PORT=8089
      /home/rohit/ai/flashnext/run-38-flash-next.sh
    proxy: http://127.0.0.1:8089
    checkEndpoint: /health
    ttl: 0
    unloadTimeout: 30
    aliases:
      - "flash-next-batch"
      - "qwen38-next-batch"

routing:
  router:
    use: group
    settings:
      groups:
        "gpu-exclusive":
          swap: true
          exclusive: true
          members:
            - qwen-38-27b
            - qwen-35b
            - qwen-35b-batch        # -np 4 batch variant of the 35B (signalpost SCORE); same GGUF, :8083
            - qwen-38-flash-next    # qwen4exp 125B MoE+PLE+MTP; isolated binary (~/ai/flashnext), :8085
            - qwen-38-flash-next-batch  # same GGUF, -np 4 / MTP-off / text-only for bulk throughput, :8089
            - qwen-embed-gpu        # on-demand GPU embedder; shares the 4090 exclusively with the chat models
        "embed-persistent":
          persistent: true    # stays loaded; NOT evicted when a chat model loads (CPU model, zero VRAM)
          swap: false         # members run concurrently (only one member here)
          members:
            - qwen-embed
